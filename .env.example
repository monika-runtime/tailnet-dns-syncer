# ─── Required ────────────────────────────────────────────
TAILSCALE_API_KEY=
TAILNET_ID=
NETLIFY_API_TOKEN=
NETLIFY_DNS_ZONE_ID=

# ─── Behaviour ───────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
DOMAIN_SUFFIX=
DEVICE_FILTER_TAG=
DRY_RUN=false
LOG_LEVEL=INFO

# ─── Optional: Nginx reverse-proxy mode ───────────────────
# Enables nginx reverse-proxy mode. A records point to
# NGINX_PUBLIC_IP instead of each device's Tailscale IP,
# and the syncer writes nginx config fragments that proxy
# traffic to the real backend over Tailscale.
#
# Requires DEVICE_FILTER_TAG to also be set.
#
# NGINX_PROXY_ENABLED=false
# NGINX_PUBLIC_IP=
# NGINX_CONFIG_DIR=/etc/nginx/conf.d
# NGINX_BACKEND_PORT=80
# NGINX_RELOAD_CMD=nginx -s reload
